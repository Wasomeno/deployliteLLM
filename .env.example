# =============================================
# REQUIRED - Generate with: openssl rand -hex 32
# =============================================
LITELLM_MASTER_KEY=sk-REPLACE-WITH-ACTUAL-KEY

# =============================================
# REQUIRED - Strong password for PostgreSQL
# =============================================
LITELLM_DB_PASSWORD=REPLACE-WITH-STRONG-DB-PASSWORD

# =============================================
# Optional - Add provider API keys below
# =============================================

# Google AI Studio / Gemini
# GOOGLEAI_API_KEY=AIza...

# Google Vertex AI
# GOOGLE_VERTEX_AI_PROJECT=your-gcp-project
# GOOGLE_VERTEX_AI_LOCATION=us-central1
# GCP_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# OpenAI
# OPENAI_API_KEY=sk-...

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Azure OpenAI
# AZURE_API_KEY=...
# AZURE_API_BASE=https://your-resource.openai.azure.com
# AZURE_API_VERSION=2024-06-01

# Groq
# GROQ_API_KEY=gsk_...

# Deepseek
# DEEPSEEK_API_KEY=sk-...

# Mistral
# MISTRAL_API_KEY=...

# Cohere
# COHERE_API_KEY=...
